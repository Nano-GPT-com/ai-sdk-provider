{
  "name": "@nanogpt/ai-sdk-provider",
  "version": "0.1.3",
  "description": "NanoGPT community provider for the Vercel AI SDK.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install",
    "release": "node ./scripts/release.mjs"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nano-GPT-com/ai-sdk-provider"
  },
  "bugs": {
    "url": "https://github.com/Nano-GPT-com/ai-sdk-provider/issues"
  },
  "keywords": [
    "vercel-ai",
    "ai-sdk",
    "nanogpt",
    "provider",
    "llm"
  ],
  "dependencies": {
    "vercel": "^50.37.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "ai": "^6.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@ai-sdk/provider-utils": "^4.0.21",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "ai": "^6.0.142",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsd": "^0.33.0",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
